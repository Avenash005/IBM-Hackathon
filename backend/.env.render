# ========================================
# RENDER ENVIRONMENT VARIABLES TEMPLATE
# ========================================
# Copy these variables to your Render service dashboard
# Go to: Dashboard → Your Service → Environment
# ========================================

# Node Environment
NODE_ENV=production
PORT=10000

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Get from MongoDB Atlas:
# 1. Create free cluster at https://www.mongodb.com/cloud/atlas
# 2. Create database user
# 3. Whitelist all IPs (0.0.0.0/0)
# 4. Get connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/pr-buddy?retryWrites=true&w=majority

# ========================================
# GITHUB CONFIGURATION
# ========================================
# Personal Access Token:
# GitHub → Settings → Developer settings → Personal access tokens
# Scopes needed: repo, admin:repo_hook
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Webhook Secret:
# Generate with: openssl rand -hex 32
# Use same value when setting up GitHub webhook
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ========================================
# GITHUB OAUTH (for user authentication)
# ========================================
# Create OAuth App:
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Homepage URL: https://your-app-name.onrender.com
# Callback URL: https://your-app-name.onrender.com/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=https://your-app-name.onrender.com/api/auth/github/callback

# ========================================
# IBM BOB API CONFIGURATION
# ========================================
# Get from your IBM Bob API account
BOB_API_URL=https://bob-api.ibm.com/v1
BOB_API_KEY=your_bob_api_key_here

# ========================================
# SECURITY SECRETS
# ========================================
# Generate with: openssl rand -hex 32
# Or let Render auto-generate these
JWT_SECRET=your-random-jwt-secret-key-min-32-chars
SESSION_SECRET=your-random-session-secret-key-min-32-chars

# ========================================
# FRONTEND CONFIGURATION
# ========================================
# Update after deploying frontend
# Examples:
# - Render: https://your-frontend-app.onrender.com
# - Vercel: https://your-app.vercel.app
# - Netlify: https://your-app.netlify.app
FRONTEND_URL=https://your-frontend-app.onrender.com

# ========================================
# OPTIONAL: ADDITIONAL CONFIGURATION
# ========================================
# JWT Token Expiration (default: 7d)
JWT_EXPIRE=7d

# Session Cookie Settings (handled by code, but can override)
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_MAX_AGE=86400000

# ========================================
# QUICK SETUP CHECKLIST
# ========================================
# [ ] 1. Create MongoDB Atlas cluster and get connection string
# [ ] 2. Create GitHub Personal Access Token
# [ ] 3. Generate webhook secret (openssl rand -hex 32)
# [ ] 4. Create GitHub OAuth App and get credentials
# [ ] 5. Get IBM Bob API key
# [ ] 6. Generate JWT and Session secrets
# [ ] 7. Deploy to Render
# [ ] 8. Update FRONTEND_URL after frontend deployment
# [ ] 9. Configure GitHub webhook with your Render URL
# [ ] 10. Test all endpoints

# ========================================
# RENDER-SPECIFIC NOTES
# ========================================
# - Render automatically sets PORT (usually 10000)
# - Use "Generate" button in Render for JWT_SECRET and SESSION_SECRET
# - Free tier: service spins down after 15 min inactivity
# - First request after spin-down takes 30-60 seconds
# - Logs available in Render dashboard
# - Auto-deploys on git push to connected branch

# ========================================
# SECURITY BEST PRACTICES
# ========================================
# ✅ Never commit this file with real values to Git
# ✅ Use strong, random secrets (min 32 characters)
# ✅ Rotate secrets periodically
# ✅ Use different secrets for dev/staging/production
# ✅ Keep MongoDB connection string secure
# ✅ Limit GitHub token permissions to minimum required
# ✅ Monitor logs for suspicious activity
# ✅ Enable 2FA on all accounts (GitHub, MongoDB, Render)

# ========================================
# TROUBLESHOOTING
# ========================================
# If deployment fails:
# 1. Check all required variables are set
# 2. Verify MongoDB connection string format
# 3. Ensure GitHub OAuth callback URL matches exactly
# 4. Check Render logs for specific errors
# 5. Verify Node version compatibility
# 6. Test MongoDB connection from Render IP
# 7. Confirm GitHub token has correct scopes

# ========================================
# SUPPORT RESOURCES
# ========================================
# Render Docs: https://render.com/docs
# MongoDB Atlas: https://docs.atlas.mongodb.com
# GitHub OAuth: https://docs.github.com/en/developers/apps/building-oauth-apps
# IBM Bob API: [Your IBM Bob documentation URL]